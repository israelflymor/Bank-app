{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated banking user profile containing identity and handle details.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^@[a-zA-Z0-9._\\-]+$"
        },
        "dateOfBirth": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{4}$"
        },
        "gender": {
          "type": "string",
          "enum": ["Male", "Female", "Other", "Prefer not to say"]
        },
        "primaryAccountNumber": {
          "type": "string",
          "minLength": 10,
          "maxLength": 12,
          "pattern": "^[0-9]{10,12}$"
        },
        "primaryRoutingNumber": {
          "type": "string",
          "minLength": 9,
          "maxLength": 11,
          "pattern": "^[0-9]{9,11}$"
        },
        "withdrawalFrozen": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "handle", "withdrawalFrozen", "createdAt", "updatedAt"]
    },
    "BankAccount": {
      "title": "BankAccount",
      "description": "User-owned deposit or treasury bank account storing exact integer balance in cents.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "accountType": {
          "type": "string",
          "enum": ["checking", "savings", "treasury"]
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "GBP"]
        },
        "accountNumber": {
          "type": "string",
          "minLength": 10,
          "maxLength": 12,
          "pattern": "^[0-9]{10,12}$"
        },
        "routingNumber": {
          "type": "string",
          "minLength": 9,
          "maxLength": 11,
          "pattern": "^[0-9]{9,11}$"
        },
        "iban": {
          "type": "string",
          "minLength": 14,
          "maxLength": 34,
          "pattern": "^[A-Z0-9]+$"
        },
        "balanceCents": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["active", "frozen"]
        },
        "lastTransferId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "accountType",
        "currency",
        "accountNumber",
        "routingNumber",
        "iban",
        "balanceCents",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "LedgerTransaction": {
      "title": "LedgerTransaction",
      "description": "Financial ledger record representing an inbound credit or outbound debit.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "direction": {
          "type": "string",
          "enum": ["credit", "debit"]
        },
        "txType": {
          "type": "string",
          "enum": [
            "deposit",
            "payment_received",
            "wire_in",
            "transfer_out",
            "internal_transfer",
            "bill_pay",
            "card_spend",
            "p2p_transfer",
            "admin_top_up"
          ]
        },
        "amountCents": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "GBP"]
        },
        "counterpartyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "counterpartyDetail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "referenceCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "memo": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "enum": ["settled", "pending", "cancelled"]
        },
        "paymentRequestId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "peerTransferId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "accountId",
        "direction",
        "txType",
        "amountCents",
        "currency",
        "counterpartyName",
        "counterpartyDetail",
        "category",
        "referenceCode",
        "memo",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Shareable payment request or invoice created by the user to receive funds.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "payerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "payerEmail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "amountCents": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "GBP"]
        },
        "memo": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "referenceCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "paid", "cancelled"]
        },
        "paidAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "accountId",
        "title",
        "payerName",
        "payerEmail",
        "amountCents",
        "currency",
        "memo",
        "referenceCode",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Beneficiary": {
      "title": "Beneficiary",
      "description": "Saved external recipient bank account for transfers and payouts.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "bankName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "routingNumber": {
          "type": "string",
          "minLength": 9,
          "maxLength": 9,
          "pattern": "^[0-9]{9}$"
        },
        "accountLast4": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$"
        },
        "accountType": {
          "type": "string",
          "enum": ["checking", "savings", "wire"]
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "bankName",
        "routingNumber",
        "accountLast4",
        "accountType",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "VirtualCard": {
      "title": "VirtualCard",
      "description": "Debit card linked to a bank account with monthly spending limits and freeze controls.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50
        },
        "holderName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "last4": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$"
        },
        "expiry": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^(0[1-9]|1[0-2])\\/[0-9]{2}$"
        },
        "network": {
          "type": "string",
          "enum": ["Visa", "Mastercard"]
        },
        "monthlyLimitCents": {
          "type": "integer"
        },
        "spentThisMonthCents": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["active", "frozen"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "accountId",
        "label",
        "holderName",
        "last4",
        "expiry",
        "network",
        "monthlyLimitCents",
        "spentThisMonthCents",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ScheduledPayment": {
      "title": "ScheduledPayment",
      "description": "Recurring or future-dated bill payment scheduled from a user account.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "payeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "amountCents": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "GBP"]
        },
        "cadence": {
          "type": "string",
          "enum": ["once", "weekly", "monthly"]
        },
        "nextDueDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["scheduled", "completed", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "accountId",
        "payeeName",
        "category",
        "amountCents",
        "currency",
        "cadence",
        "nextDueDate",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "RecipientDirectoryEntry": {
      "title": "RecipientDirectoryEntry",
      "description": "PII-safe lookup entry keyed by handle, account number, or SHA-256 email hash for peer transfers.",
      "type": "object",
      "properties": {
        "lookupKey": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9._\\-]+$"
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^@[a-zA-Z0-9._\\-]+$"
        },
        "accountName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "accountLast4": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$"
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "GBP"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "frozen"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "lookupKey",
        "accountId",
        "userId",
        "displayName",
        "handle",
        "accountName",
        "accountLast4",
        "currency",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "PeerTransfer": {
      "title": "PeerTransfer",
      "description": "Immutable atomic proof record linking an outgoing sender debit to an incoming recipient credit.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromAccountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toAccountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amountCents": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "EUR", "GBP"]
        },
        "referenceCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "memo": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "fromUserId",
        "fromAccountId",
        "toUserId",
        "toAccountId",
        "amountCents",
        "currency",
        "referenceCode",
        "memo",
        "createdAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Registry record granting system-wide administrative control to a verified user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "grantedBy", "createdAt", "updatedAt"]
    },
    "MemberCredential": {
      "title": "MemberCredential",
      "description": "Hash-protected binding linking a member's generated account number and routine number to their Auth UID.",
      "type": "object",
      "properties": {
        "accountNumber": {
          "type": "string",
          "minLength": 10,
          "maxLength": 12,
          "pattern": "^[0-9]{10,12}$"
        },
        "routingHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "claimProof": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "pattern": "^([a-f0-9]{64})?$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "claimedUid": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["accountNumber", "routingHash", "claimProof", "userId", "claimedUid", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user banking profile keyed by Firebase Auth UID."
    },
    "/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/BankAccount" },
      "description": "Deposit and treasury accounts owned by users."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/LedgerTransaction" },
      "description": "Immutable financial ledger entries linked to user accounts."
    },
    "/paymentRequests/{requestId}": {
      "schema": { "$ref": "#/entities/PaymentRequest" },
      "description": "Shareable payment requests and invoices to receive funds."
    },
    "/beneficiaries/{beneficiaryId}": {
      "schema": { "$ref": "#/entities/Beneficiary" },
      "description": "Saved transfer recipients and payout counterparties."
    },
    "/cards/{cardId}": {
      "schema": { "$ref": "#/entities/VirtualCard" },
      "description": "Virtual and debit cards linked to user bank accounts."
    },
    "/scheduledPayments/{scheduledId}": {
      "schema": { "$ref": "#/entities/ScheduledPayment" },
      "description": "Scheduled and recurring bill payments."
    },
    "/recipientDirectory/{lookupKey}": {
      "schema": { "$ref": "#/entities/RecipientDirectoryEntry" },
      "description": "Deterministic non-PII lookup entries for resolving transfer recipients."
    },
    "/peerTransfers/{transferId}": {
      "schema": { "$ref": "#/entities/PeerTransfer" },
      "description": "Immutable atomic proof documents for peer-to-peer transfers."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Delegated admin authorization registry."
    },
    "/memberCredentials/{accountNumber}": {
      "schema": { "$ref": "#/entities/MemberCredential" },
      "description": "Hash-protected account and routine credential bindings for member login and seeded account claiming."
    }
  }
}
